/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The chapter bundles hold the whole plot: never index them or show them in
# search snippets. Not blocked in robots.txt, so crawlers can see this header
# (and so the page itself can still be rendered by search engines).
/data/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex, nofollow

# The workers.dev address serves the same site; keep it out of search results
# so only https://ironuntangled.app/ is indexed.
https://iron-untangled.canalesb93.workers.dev/*
  X-Robots-Tag: noindex
